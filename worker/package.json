{
  "name": "docflare-worker",
  "version": "1.0.0",
  "description": "Docflare secure document management backend on Cloudflare Workers",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "cf-typegen": "wrangler types",
    "migrate:local": "wrangler d1 migrations apply docflare-db --local",
    "migrate:prod": "wrangler d1 migrations apply docflare-db --remote"
  },
  "dependencies": {
    "hono": "^4.6.3",
    "@paralleldrive/cuid2": "^2.2.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.38",
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^3.87.0"
  }
}
